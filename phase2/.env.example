# Copy to .env in phase2/ and fill in — never commit .env to git

# AI provider — use one or both; OpenAI takes priority if both are set
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for transformation
# OpenAI:    gpt-4o | gpt-4o-mini | gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
MODEL=gpt-4o

# How many atoms to transform per profile in the batch endpoint
# Lower = faster demo; higher = more content
ATOMS_TO_TRANSFORM=3

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
