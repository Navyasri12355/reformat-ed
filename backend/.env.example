# Copy to .env and edit as needed. Every value has a working default.

# --- Database (SQLite default; swap for Postgres in prod) ---
# DATABASE_URL=postgresql+psycopg://neuracore:password@localhost:5432/neuracore

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- AI (leave blank to use the offline local rule-based transformer) ---
# For OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-11-20
# OPENAI_BASE_URL=

# For Gemini (via OpenAI compatibility layer):
# OPENAI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# OPENAI_BASE_URL=https://generativetoolkit.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-1.5-flash

# --- Task backend: "inline" (no Redis) or "celery" ---
TASK_BACKEND=inline
# REDIS_URL=redis://localhost:6379/0

# --- Text-to-speech (Coqui). Install `TTS` to enable server-side audio;
#     otherwise the browser voice is used with the same per-profile modulation.
# COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC

# --- Demo convenience: skip the educator review queue so a single user can
#     prepare and immediately learn. Leave false to keep the review gate.
AUTO_APPROVE_ALL=false

# --- Limits ---
MAX_FILE_SIZE_MB=50
MAX_ATOMS_PER_DOCUMENT=500
